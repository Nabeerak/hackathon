# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# PostgreSQL database URL (Neon, Railway, Supabase, etc.)
# Get from: https://neon.tech dashboard -> Connection String
# Format: postgresql://username:password@host/database?sslmode=require
NEON_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require"

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------------------------------
# JWT secret key for token signing (min 32 characters, max 64 recommended)
# Generate with: openssl rand -hex 32
# or: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# BetterAuth secret for session management (same as JWT or separate)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="your-better-auth-secret-key-change-this-in-production"

# ----------------------------------------------------------------------------
# QDRANT VECTOR DATABASE
# ----------------------------------------------------------------------------
# Qdrant cloud instance URL (get from Qdrant Cloud dashboard)
# Format: https://your-cluster-id.region.aws.cloud.qdrant.io
# For local Qdrant: http://localhost:6333
QDRANT_URL="https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io"

# Qdrant API key (get from Qdrant Cloud dashboard)
# Leave empty for local Qdrant without authentication
QDRANT_API_KEY="your-qdrant-api-key-here"

# ----------------------------------------------------------------------------
# AI / LLM CONFIGURATION
# ----------------------------------------------------------------------------
# OpenAI API key for embeddings and chat completion
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# ----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Render API key for deployment automation (only if using Render)
# Get from: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY="rnd_your-render-api-key-here"

# Environment mode: development | production | staging
ENVIRONMENT="development"

# ----------------------------------------------------------------------------
# CORS & API CONFIGURATION
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Production: add your frontend domain
# Development: include localhost:3000, localhost:3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://yourdomain.com"

# Session duration in days (default: 7)
SESSION_DURATION_DAYS=7

# Server configuration
HOST="0.0.0.0"
PORT=8000

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (docusaurus-book/.env)
# ============================================================================
# Backend API URL for frontend to connect to
# Development: http://localhost:8000/api
# Production: https://your-backend.onrender.com/api
REACT_APP_API_URL="http://localhost:8000/api"
