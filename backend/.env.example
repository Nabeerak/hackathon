# Backend environment variables
# Copy this file to .env and replace with your actual credentials

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Qdrant Vector Database Configuration
# Sign up for free at: https://qdrant.tech/
QDRANT_URL="https://your-instance.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"

# Gemini API Configuration (Optional - used for alternative chat completions)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Configuration
# CONSTITUTION REQUIREMENT: Must use Neon Serverless Postgres in production
# Sign up for free at: https://neon.tech/
# After creating a project, get your connection string from the dashboard

# Neon PostgreSQL (REQUIRED for constitution compliance)
NEON_DATABASE_URL="postgresql://neondb_owner:npg_bn2H0AqWeNpv@ep-lingering-meadow-a1l67fjv-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

